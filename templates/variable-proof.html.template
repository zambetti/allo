<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Allo · variable pair proof</title>
  <style>
    :root { color-scheme: light; font-family: system-ui, sans-serif; color: #222; background: #f5f5f3; }
    * { box-sizing: border-box; }
    body { margin: 0; padding: clamp(1rem, 2vw, 1.5rem); }
    main { max-width: 76rem; margin: 0 auto; }
    h1 { font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 600; letter-spacing: -.035em; margin: 0; }
    h2, legend { font-size: 1rem; font-weight: 600; }
    p { line-height: 1.55; }
    .muted, .help { color: #595959; }
    .help { font-size: .875rem; margin: .5rem 0 0; }
    header { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; margin-bottom: 1rem; }
    header h1, header .muted { flex-basis: 100%; }
    header p { margin: 0; }
    header .file { flex: 1 1 24rem; font-size: .875rem; }
    code, pre, output { font-family: ui-monospace, monospace; }
    .file { overflow-wrap: anywhere; }
    #font-status { padding: .5rem .75rem; border: 1px solid #888; border-radius: .4rem; background: white; font-size: .875rem; }
    #font-status[data-state="failed"], .warning { border-left: .3rem solid #a43521; color: #752719; background: #fff7f3; }
    .warning { padding: .65rem .9rem; }
    .workbench { display: grid; gap: 1rem; align-items: start; }
    .workspace { min-width: 0; }
    .controls { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    fieldset, .panel { min-width: 0; margin: 0; padding: 1rem 1.25rem; border: 1px solid #ccc; border-radius: .6rem; background: white; }
    legend { padding: 0 .35rem; }
    .characters { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    label { display: block; line-height: 1.4; }
    input[type="text"] { display: block; width: 100%; min-height: 2.75rem; margin-top: .4rem; padding: .5rem .65rem; font: inherit; font-size: 1.25rem; border: 1px solid #777; border-radius: .3rem; }
    input[type="range"] { display: block; width: 100%; margin: .35rem 0 0; min-height: 2.75rem; accent-color: #333; }
    input[type="checkbox"] { width: 1.15rem; height: 1.15rem; margin: 0; accent-color: #333; flex-shrink: 0; }
    .check { display: flex; align-items: center; gap: .65rem; min-height: 2.75rem; }
    .presets { display: flex; flex-wrap: wrap; gap: .5rem; margin: .75rem 0; }
    button { min-height: 2.75rem; padding: .5rem .9rem; border: 1px solid #888; border-radius: .35rem; background: #f7f7f5; color: #222; font: inherit; cursor: pointer; }
    button:hover { background: #eaeae7; }
    :focus-visible { outline: 3px solid #265f9e; outline-offset: 3px; }
    #axis-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); gap: 1rem 1.25rem; }
    .axis-heading { display: flex; justify-content: space-between; align-items: baseline; gap: .5rem; }
    .axis-heading output { font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .axis-tag { color: #595959; font-weight: normal; }
    .axis-bounds { display: flex; justify-content: space-between; font-size: .8rem; color: #595959; }
    .axes h2 { margin: 0 0 .75rem; }
    #axis-summary { display: block; margin-top: .5rem; overflow-wrap: anywhere; font-size: .875rem; }
    .toolbar { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: .75rem 1rem; margin: .75rem 0; }
    .preview-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .preview-grid.without-comparison { grid-template-columns: minmax(0, 1fr); }
    .preview { min-width: 0; border: 1px solid #ccc; border-radius: .6rem; background: white; overflow: hidden; }
    .preview h2 { margin: 0; padding: .85rem 1rem; border-bottom: 1px solid #ddd; }
    .sample-viewport { overflow-x: auto; min-height: 12rem; padding: .5rem 1rem 1rem; }
    .pair { display: block; width: max-content; min-width: 100%; text-align: center; white-space: pre; line-height: 1.4; letter-spacing: 0; text-transform: none; font-style: normal; font-synthesis: none; font-optical-sizing: none; }
    .sample-viewport:focus-visible { outline-offset: -4px; }
    details { margin-top: 1rem; border-top: 1px solid #ccc; padding-top: 1rem; }
    summary { width: fit-content; min-height: 2.75rem; padding: .5rem 0; cursor: pointer; font-weight: 600; }
    pre { padding: 1rem; margin: .5rem 0; background: white; border: 1px solid #ccc; border-radius: .4rem; white-space: pre-wrap; overflow-wrap: anywhere; font-size: .875rem; line-height: 1.6; }
    footer { margin-top: 1.5rem; }
    [hidden] { display: none !important; }
    @media (min-width: 72rem) {
      .workbench { grid-template-columns: 20rem minmax(0, 1fr); }
      .controls { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 42rem) {
      .controls, .preview-grid { grid-template-columns: minmax(0, 1fr); }
      fieldset, .panel { padding: .85rem; }

      .sample-viewport { padding-inline: .75rem; }
    }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Variable pair proof</h1>
    <p class="muted">Two characters, one shaped text run. Explore the real variable axes, spacing, and optional g.</p>
    <p class="file"><strong id="font-name">Embedded variable font</strong> · <code id="font-filename"></code></p>
    <p id="font-status" role="status" aria-live="polite" aria-atomic="true" data-state="loading">Loading the embedded font… previews stay hidden until it is ready.</p>
    <noscript><p class="warning">JavaScript is required to load the embedded font and operate the proof. No fallback preview is shown.</p></noscript>
  </header>

  <div class="workbench">
  <div class="controls">
    <fieldset>
      <legend>Character pair</legend>
      <div class="characters">
        <label for="left-character">Left character / cluster
          <input id="left-character" type="text" value="n" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="pair-help">
        </label>
        <label for="right-character">Right character / cluster
          <input id="right-character" type="text" value="g" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="pair-help">
        </label>
      </div>
      <p id="pair-help" class="help">Two fields, one text run: combining marks and the font’s real kerning are preserved.</p>
      <div class="presets" role="group" aria-label="Pair presets">
        <button type="button" data-left="n" data-right="g" aria-label="Pair n g">ng</button>
        <button type="button" data-left="g" data-right="o" aria-label="Pair g o">go</button>
        <button type="button" data-left="g" data-right="g" aria-label="Pair g g">gg</button>
        <button type="button" data-left="a" data-right="g" aria-label="Pair a g">ag</button>
        <button type="button" data-left="g" data-right="y" aria-label="Pair g y">gy</button>
        <button type="button" data-left="g&#x0301;" data-right="o" aria-label="Pair g with combining acute accent, o">ǵo</button>
        <button type="button" data-left="n" data-right="&#x0123;" aria-label="Pair n, g with cedilla">nģ</button>
      </div>
    </fieldset>
    <fieldset>
      <legend>OpenType &amp; comparison</legend>
      <label class="check"><input id="ss04" type="checkbox" checked> Double-storey g <code>ss04</code></label>
      <label class="check"><input id="ss01" type="checkbox"> Single-storey a <code>ss01</code></label>
      <label class="check"><input id="kerning" type="checkbox" checked> Kerning</label>
      <label class="check"><input id="show-comparison" type="checkbox" checked> Show default-g comparison</label>
      <p id="feature-status" class="help"></p>
    </fieldset>
  </div>

  <div class="workspace">
  <section class="panel axes" aria-labelledby="axes-heading">
    <h2 id="axes-heading">Variable axes</h2>
    <div id="axis-controls"></div>
    <output id="axis-summary" aria-label="Current variable coordinates"></output>
  </section>

  <div class="toolbar">
    <div>
      <div class="axis-heading">
        <label for="preview-size">Preview size</label>
        <output id="preview-size-value" for="preview-size">176 px</output>
      </div>
      <input id="preview-size" type="range" min="24" max="320" step="1" value="176" aria-describedby="size-help">
      <p id="size-help" class="help">Pixels only; optical size stays independent.</p>
    </div>
    <button id="reset" type="button" aria-label="Reset all controls">Reset all</button>
  </div>

  <p id="coverage-status" class="warning" role="status" aria-live="polite" hidden></p>
  <section id="previews" class="preview-grid" aria-label="Shaped pair previews" aria-busy="true">
    <article class="preview">
      <h2 id="main-heading">Main pair · ss04 on</h2>
      <div class="sample-viewport" role="region" aria-labelledby="main-heading" tabindex="0">
        <span id="main-pair" class="pair" dir="auto" hidden></span>
      </div>
    </article>
    <article id="comparison-card" class="preview">
      <h2 id="comparison-heading">Default g · ss04 off</h2>
      <div class="sample-viewport" role="region" aria-labelledby="comparison-heading" tabindex="0">
        <span id="comparison-pair" class="pair" dir="auto" hidden></span>
      </div>
    </article>
  </section>
  <p class="help">Comparison shares every axis, size, kerning, and <code>ss01</code> setting; only <code>ss04</code> is forced off. No letter-spacing adjustment is applied.</p>

  <details>
    <summary>Current CSS · main pair</summary>
    <pre><code id="css-readout"></code></pre>
    <p class="help">Axis labels, limits, and defaults come from this font’s <code>fvar</code> table. Upright variable font only: obliques are separate static fonts, not a simulated slant. Oversized pairs scroll within their card.</p>
    <p class="help">The family alias belongs only to this page’s embedded font. For the comparison, use the same CSS with <code>"ss04" 0</code>.</p>
  </details>
  </div>
  </div>
  <footer class="help">Self-contained WOFF2 proof. No font installation, server, or network required. Rendering may vary by browser and operating system.</footer>
</main>
<script id="variable-proof-data" type="application/json">__VARIABLE_PROOF_DATA__</script>
<script>
(() => {
  'use strict';
  const byId = id => document.getElementById(id);
  const status = byId('font-status');
  const pairs = [byId('main-pair'), byId('comparison-pair')];
  let loaded = false;

  function fail(error) {
    loaded = false;
    for (const pair of pairs) pair.hidden = true;
    byId('previews').setAttribute('aria-busy', 'false');
    status.dataset.state = 'failed';
    status.textContent = 'Font load failed. Previews are hidden; no fallback proof is shown. ' + error.message;
  }

  async function start() {
    const config = JSON.parse(byId('variable-proof-data').textContent);
    const left = byId('left-character');
    const right = byId('right-character');
    const size = byId('preview-size');
    const ss04 = byId('ss04');
    const ss01 = byId('ss01');
    const kerning = byId('kerning');
    const comparison = byId('show-comparison');
    const controls = [];
    const supported = new Set(config.codepoints);
    const family = JSON.stringify(config.fontFamily);
    byId('font-name').textContent = config.family;
    byId('font-filename').textContent = config.filename;
    document.title = config.family + ' · variable pair proof';
    const missingFeatures = ['ss04', 'ss01'].filter(tag => !config.features.includes(tag));
    byId('feature-status').textContent = missingFeatures.length
      ? 'Not advertised by this font: ' + missingFeatures.join(', ') + '. Those switches have no effect; a font built with the corresponding alternates is needed.'
      : 'Both ss04 and ss01 are present in the embedded font.';
    byId('feature-status').classList.toggle('warning', missingFeatures.length > 0);

    for (const [index, axis] of config.axes.entries()) {
      const wrapper = document.createElement('div');
      const heading = document.createElement('div');
      heading.className = 'axis-heading';
      const label = document.createElement('label');
      label.htmlFor = 'axis-' + index;
      label.append(document.createTextNode(axis.name + ' '));
      const tag = document.createElement('code');
      tag.className = 'axis-tag';
      tag.textContent = axis.tag;
      label.append(tag);
      const value = document.createElement('output');
      value.htmlFor = label.htmlFor;
      value.id = 'axis-value-' + index;
      const slider = document.createElement('input');
      slider.type = 'range';
      slider.id = label.htmlFor;
      slider.dataset.axis = axis.tag;
      slider.min = axis.min;
      slider.max = axis.max;
      slider.step = 'any';
      slider.value = axis.default;
      slider.disabled = axis.min === axis.max;
      const bounds = document.createElement('div');
      bounds.className = 'axis-bounds';
      bounds.id = 'axis-bounds-' + index;
      for (const text of [axis.min, 'default ' + axis.default, axis.max]) {
        const bound = document.createElement('span');
        bound.textContent = text;
        bounds.append(bound);
      }
      slider.setAttribute('aria-describedby', bounds.id);
      heading.append(label, value);
      wrapper.append(heading, slider, bounds);
      byId('axis-controls').append(wrapper);
      controls.push({axis, slider, value});
      slider.addEventListener('input', update);
    }

    function update() {
      const text = left.value + right.value;
      const variations = controls.map(({axis, slider, value}) => {
        value.value = slider.value;
        return JSON.stringify(axis.tag) + ' ' + Number(slider.value);
      }).join(', ');
      const weight = controls.find(({axis}) => axis.tag === 'wght');
      const fontWeight = weight ? weight.slider.value : '400';
      const features = alternate => '"ss04" ' + Number(alternate) + ', "ss01" ' + Number(ss01.checked) + ', "kern" ' + Number(kerning.checked);
      for (const [index, pair] of pairs.entries()) {
        // A single text node is essential: per-character elements can break kerning.
        pair.textContent = text;
        pair.style.fontFamily = family;
        pair.style.fontVariationSettings = variations;
        pair.style.fontWeight = fontWeight;
        pair.style.fontSize = size.value + 'px';
        pair.style.fontKerning = kerning.checked ? 'normal' : 'none';
        pair.style.fontFeatureSettings = features(index === 0 && ss04.checked);
        pair.hidden = !loaded;
      }
      byId('main-heading').textContent = 'Main pair · ss04 ' + (ss04.checked ? 'on' : 'off');
      byId('comparison-card').hidden = !comparison.checked;
      byId('previews').classList.toggle('without-comparison', !comparison.checked);
      byId('preview-size-value').value = size.value + ' px';
      byId('axis-summary').value = controls.map(({axis, slider}) => axis.tag + ' ' + slider.value).join(' · ');
      byId('css-readout').textContent = [
        'font-family: ' + family + ';',
        'font-size: ' + size.value + 'px;',
        'font-weight: ' + fontWeight + ';',
        'font-style: normal;',
        'font-variation-settings: ' + variations + ';',
        'font-optical-sizing: none;',
        'font-synthesis: none;',
        'font-kerning: ' + (kerning.checked ? 'normal' : 'none') + ';',
        'font-feature-settings: ' + features(ss04.checked) + ';',
        'letter-spacing: 0;',
      ].join('\n');
      // Report character fallback as well as whole-font load failure. Join controls
      // and variation selectors are default-ignorable, not missing visible glyphs.
      const missing = [...new Set(Array.from(text, char => char.codePointAt(0)))].filter(cp =>
        !supported.has(cp) && cp !== 0x200c && cp !== 0x200d && !(cp >= 0xfe00 && cp <= 0xfe0f));
      const coverage = byId('coverage-status');
      coverage.hidden = missing.length === 0;
      coverage.textContent = missing.length
        ? 'Not covered by the embedded font: ' + missing.map(cp => 'U+' + cp.toString(16).toUpperCase().padStart(4, '0')).join(', ') + '. These characters may use browser fallback; they are not a reliable font proof.'
        : '';
    }

    for (const field of [left, right, size]) field.addEventListener('input', update);
    for (const toggle of [ss04, ss01, kerning, comparison]) toggle.addEventListener('change', update);
    for (const preset of document.querySelectorAll('[data-left]')) {
      preset.addEventListener('click', () => {
        left.value = preset.dataset.left;
        right.value = preset.dataset.right;
        update();
      });
    }
    byId('reset').addEventListener('click', () => {
      left.value = 'n';
      right.value = 'g';
      size.value = size.defaultValue;
      ss04.checked = kerning.checked = comparison.checked = true;
      ss01.checked = false;
      for (const {axis, slider} of controls) slider.value = axis.default;
      update();
    });
    update();
    if (!window.FontFace || !document.fonts) throw new Error('This browser does not support the Font Loading API.');
    const weightAxis = config.axes.find(axis => axis.tag === 'wght');
    const face = new FontFace(config.fontFamily, 'url("data:font/woff2;base64,' + config.fontBase64 + '") format("woff2")', {
      style: 'normal',
      weight: weightAxis ? weightAxis.min + ' ' + weightAxis.max : 'normal',
    });
    let timer;
    try {
      await Promise.race([
        face.load(),
        new Promise((_, reject) => {
          timer = setTimeout(() => reject(new Error('The embedded font did not load within 15 seconds.')), 15000);
        }),
      ]);
    } finally {
      clearTimeout(timer);
    }
    if (face.status !== 'loaded') throw new Error('The embedded font did not report a successful load.');
    document.fonts.add(face);
    loaded = true;
    update();
    byId('previews').setAttribute('aria-busy', 'false');
    status.dataset.state = 'ready';
    status.textContent = 'Embedded font loaded · ' + config.axes.length + ' variable axes · offline ready.';
  }
  start().catch(fail);
})();
</script>
</body>
</html>
