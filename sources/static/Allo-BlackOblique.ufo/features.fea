feature clig {
  lookup arrows {
    ignore sub @NOT_SPACE less' hyphen' greater';
    ignore sub less' hyphen' greater' @NOT_SPACE;
    sub less' hyphen' greater' by leftRightArrow;
    ignore sub @NOT_SPACE less' equal' greater';
    ignore sub less' equal' greater' @NOT_SPACE;
    sub less' equal' greater' by leftRightDoubleArrow;
    ignore sub @NOT_SPACE hyphen' hyphen' greater';
    ignore sub hyphen' hyphen' greater' @NOT_SPACE;
    sub hyphen' hyphen' greater' by rightArrow;
    ignore sub @NOT_SPACE less' hyphen' hyphen';
    ignore sub less' hyphen' hyphen' @NOT_SPACE;
    sub less' hyphen' hyphen' by leftArrow;
    ignore sub @NOT_SPACE hyphen' greater';
    ignore sub hyphen' greater' @NOT_SPACE;
    sub hyphen' greater' by rightArrow;
    ignore sub @NOT_SPACE equal' greater';
    ignore sub equal' greater' @NOT_SPACE;
    sub equal' greater' by rightDoubleArrow;
    ignore sub @NOT_SPACE less' hyphen';
    ignore sub less' hyphen' @NOT_SPACE;
    sub less' hyphen' by leftArrow;
  } arrows;
} clig;

feature calt {
  lookup nearCaps {
    sub @CAPS @CASE_IN' @CAPS by @CASE_OUT;
    sub @CAPS space @CASE_IN' space @CAPS by @CASE_OUT;
    sub @CAPS @CASE_IN' space @CAPS by @CASE_OUT;
    sub @CAPS space @CASE_IN' @CAPS by @CASE_OUT;
    sub @OPEN' @CAPS @CAPS by @OPEN_CASE;
    sub @OPEN' @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @OPEN' @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CAPS @CAPS @CLOSE by @OPEN_CASE;
    sub @CAPS @CAPS @CLOSE' by @CLOSE_CASE;
    sub [exclamdown questiondown at]' @CAPS @CAPS by [exclamdown.case questiondown.case at.case];
    ignore sub [a aacute abreve abreveacute abrevedotbelow abrevegrave abrevehookabove abrevetilde acircumflex acircumflexacute acircumflexdotbelow acircumflexgrave acircumflexhookabove acircumflextilde adieresis adotbelow ae agrave ahookabove amacron aogonek aring atilde b c cacute ccaron ccedilla ccircumflex cdotaccent d dcaron dcroat e eacute ebreve ecaron ecircumflex ecircumflexacute ecircumflexdotbelow ecircumflexgrave ecircumflexhookabove ecircumflextilde edieresis edotaccent edotbelow egrave ehookabove emacron eng eogonek eth etilde f florin g gbreve gcircumflex gcommaaccent gdotaccent germandbls h hbar hcircumflex hdotbelow i iacute ibreve icircumflex idieresis idotbelow idotless igrave ihookabove ij imacron iogonek itilde j jcircumflex jdotless k kcommaaccent kgreenlandic l lacute lcaron lcommaaccent ldot ldotbelow longs lslash m micro n nacute ncaron ncommaaccent ntilde o oacute obreve ocircumflex ocircumflexacute ocircumflexdotbelow ocircumflexgrave ocircumflexhookabove ocircumflextilde odieresis odotbelow oe ograve ohookabove ohorn ohornacute ohorndotbelow ohorngrave ohornhookabove ohorntilde ohungarumlaut omacron oslash otilde p q r racute rcaron rcommaaccent s sacute scaron scedilla scircumflex scommaaccent t tbar tcaron tcedilla tcommaaccent thorn u uacute ubreve ucircumflex udieresis udotbelow ugrave uhookabove uhorn uhornacute uhorndotbelow uhorngrave uhornhookabove uhorntilde uhungarumlaut umacron uogonek uring utilde v w wacute wcircumflex wdieresis wgrave x y yacute ycircumflex ydieresis ydotbelow ygrave yhookabove ytilde z zacute zcaron zdotaccent g.ss04 gcircumflex.ss04 gbreve.ss04 gdotaccent.ss04 gcommaaccent.ss04] [plus minus]' [zero one two three four five six seven eight nine afii57636 baht bitcoin cedi cent coloncurrency currency dollar dong euro guarani hryvnia kip lari manat naira peso sterling tenge tugrik uni058F uni060B uni09F3 uni17DB uni20B9 uni20BA uni20BD won yen];
    sub [plus minus]' [zero one two three four five six seven eight nine afii57636 baht bitcoin cedi cent coloncurrency currency dollar dong euro guarani hryvnia kip lari manat naira peso sterling tenge tugrik uni058F uni060B uni09F3 uni17DB uni20B9 uni20BA uni20BD won yen] by [plus.case minus.case];
  } nearCaps;
  lookup bracketPairs {
    sub @OPEN_CASE @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
    sub @OPEN_CASE @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @NOT_BRACKET @CLOSE' by @CLOSE_CASE;
  } bracketPairs;
  lookup timeColon {
    sub @FIG colon' @FIG by colon.case;
  } timeColon;
  lookup shortF {
    sub f' [igrave icircumflex idieresis itilde imacron ibreve] by f.short;
  } shortF;
} calt;

feature liga {
  sub t t t by t_t_t;
  sub t t f by t_t_f;
  sub t f t by t_f_t;
  sub t f f by t_f_f;
  sub f t t by f_t_t;
  sub f t f by f_t_f;
  sub f f t by f_f_t;
  sub f f f by f_f_f;
  sub t t by t_t;
  sub f f by f_f;
  sub t f by t_f;
  sub f t by f_t;
} liga;

feature case {
  sub @CASE_IN by @CASE_OUT;
} case;

feature sups {
  sub @FIG by @SUPS;
} sups;

feature subs {
  sub @FIG by @SUBS;
} subs;

feature numr {
  sub @FIG by @NUMR;
} numr;

feature dnom {
  sub @FIG by @DNOM;
} dnom;

feature frac {
  lookup fracBar {
    ignore sub slash @FIG slash';
    ignore sub slash @FIG @FIG slash';
    ignore sub slash @FIG @FIG @FIG slash';
    ignore sub slash @FIG @FIG @FIG @FIG slash';
    ignore sub slash' @FIG slash;
    ignore sub slash' @FIG @FIG slash;
    ignore sub slash' @FIG @FIG @FIG slash;
    ignore sub slash' @FIG @FIG @FIG @FIG slash;
    sub @FIG slash' @FIG by fraction;
  } fracBar;
  lookup fracNumr { rsub @FIG' [fraction @NUMR] by @NUMR; } fracNumr;
  lookup fracDnom { sub [fraction @DNOM] @FIG' by @DNOM; } fracDnom;
} frac;

feature tnum {
  sub @FIG by [zero.tf one.foot.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf];
  sub zero.slash by zero.tf.slash;
  sub zero.dot by zero.tf.dot;
} tnum;

feature zero {
  sub zero by zero.slash;
  sub zero.tf by zero.tf.slash;
} zero;

feature ss01 {
  featureNames { name "Single-story a"; };
  sub a by a.1;
  sub aacute by aacute.1;
  sub abreve by abreve.1;
  sub acircumflex by acircumflex.1;
  sub adieresis by adieresis.1;
  sub agrave by agrave.1;
  sub amacron by amacron.1;
  sub aogonek by aogonek.1;
  sub aring by aring.1;
  sub atilde by atilde.1;
  sub adotbelow by adotbelow.1;
  sub ahookabove by ahookabove.1;
  sub abreveacute by abreveacute.1;
  sub abrevegrave by abrevegrave.1;
  sub abrevehookabove by abrevehookabove.1;
  sub abrevetilde by abrevetilde.1;
  sub abrevedotbelow by abrevedotbelow.1;
  sub acircumflexacute by acircumflexacute.1;
  sub acircumflexgrave by acircumflexgrave.1;
  sub acircumflexhookabove by acircumflexhookabove.1;
  sub acircumflextilde by acircumflextilde.1;
  sub acircumflexdotbelow by acircumflexdotbelow.1;
} ss01;

feature ss02 {
  featureNames { name "Disambiguation"; };
  sub l by l.ss02;
  sub lacute by lacute.ss02;
  sub lcaron by lcaron.ss02;
  sub lcommaaccent by lcommaaccent.ss02;
  sub ldot by ldot.ss02;
  sub lslash by lslash.ss02;
  sub I by I.1;
  sub Iacute by Iacute.1;
  sub Ibreve by Ibreve.1;
  sub Icircumflex by Icircumflex.1;
  sub Idieresis by Idieresis.1;
  sub Idotaccent by Idotaccent.1;
  sub Igrave by Igrave.1;
  sub Imacron by Imacron.1;
  sub Iogonek by Iogonek.1;
  sub Itilde by Itilde.1;
  sub Idotbelow by Idotbelow.1;
  sub Ihookabove by Ihookabove.1;
  sub zero by zero.slash;
  sub zero.tf by zero.tf.slash;
  sub one by one.foot;
  sub one.tf by one.foot.tf;
} ss02;

feature ss03 {
  featureNames { name "Open figures"; };
  sub four by four.ss01;
  sub six by six.ss01;
  sub nine by nine.ss01;
  sub four.tf by four.tf.ss01;
  sub six.tf by six.tf.ss01;
  sub nine.tf by nine.tf.ss01;
} ss03;

