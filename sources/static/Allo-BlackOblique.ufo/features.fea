languagesystem DFLT dflt;
languagesystem latn dflt;

@FIG = [zero one two three four five six seven eight nine];
@TF = [zero.tf one.tf two.tf three.tf four.tf five.tf six.tf seven.tf eight.tf nine.tf];
feature ccmp {
  sub [i j]' [gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb caroncomb hookabovecomb] by [idotless jdotless];
} ccmp;

@SUPS = [zero.sups one.sups two.sups three.sups four.sups five.sups six.sups seven.sups eight.sups nine.sups];
@SUBS = [zero.subs one.subs two.subs three.subs four.subs five.subs six.subs seven.subs eight.subs nine.subs];
@NUMR = [zero.numr one.numr two.numr three.numr four.numr five.numr six.numr seven.numr eight.numr nine.numr];
@DNOM = [zero.dnom one.dnom two.dnom three.dnom four.dnom five.dnom six.dnom seven.dnom eight.dnom nine.dnom];
@CASE_IN = [approxequal asciitilde asterisk at braceleft braceright bracketleft bracketright bullet colon divide emdash endash equal exclamdown figuredash greater greaterequal hyphen hyphennobreak infinity leftArrow leftDoubleArrow leftRightArrow leftRightDoubleArrow less lessequal minus multiply northEastArrow northWestArrow notequal parenleft parenright plus plusminus questiondown rightArrow rightDoubleArrow southEastArrow southWestArrow];
@CASE_OUT = [approxequal.case asciitilde.case asterisk.case at.case braceleft.case braceright.case bracketleft.case bracketright.case bullet.case colon.case divide.case emdash.case endash.case equal.case exclamdown.case figuredash.case greater.case greaterequal.case hyphen.case hyphennobreak.case infinity.case leftArrow.case leftDoubleArrow.case leftRightArrow.case leftRightDoubleArrow.case less.case lessequal.case minus.case multiply.case northEastArrow.case northWestArrow.case notequal.case parenleft.case parenright.case plus.case plusminus.case questiondown.case rightArrow.case rightDoubleArrow.case southEastArrow.case southWestArrow.case];
@CAPS = [A AE Aacute Abreve Abreveacute Abrevedotbelow Abrevegrave Abrevehookabove Abrevetilde Acircumflex Acircumflexacute Acircumflexdotbelow Acircumflexgrave Acircumflexhookabove Acircumflextilde Adieresis Adotbelow Agrave Ahookabove Amacron Aogonek Aring Atilde B C Cacute Ccaron Ccedilla Ccircumflex Cdotaccent D Dcaron Dcroat E Eacute Ebreve Ecaron Ecircumflex Ecircumflexacute Ecircumflexdotbelow Ecircumflexgrave Ecircumflexhookabove Ecircumflextilde Edieresis Edotaccent Edotbelow Egrave Ehookabove Emacron Eng Eogonek Eth Etilde F G Gbreve Gcircumflex Gcommaaccent Gdotaccent Germandbls H Hbar Hcircumflex Hdotbelow I IJ Iacute Ibreve Icircumflex Idieresis Idotaccent Idotbelow Igrave Ihookabove Imacron Iogonek Itilde J Jcircumflex K Kcommaaccent L Lacute Lcaron Lcommaaccent Ldot Ldotbelow Lslash M N Nacute Ncaron Ncommaaccent Ntilde O OE Oacute Obreve Ocircumflex Ocircumflexacute Ocircumflexdotbelow Ocircumflexgrave Ocircumflexhookabove Ocircumflextilde Odieresis Odotbelow Ograve Ohookabove Ohorn Ohornacute Ohorndotbelow Ohorngrave Ohornhookabove Ohorntilde Ohungarumlaut Omacron Oslash Otilde P Q R Racute Rcaron Rcommaaccent S Sacute Scaron Scedilla Scircumflex Scommaaccent T Tbar Tcaron Tcommaaccent Thorn U Uacute Ubreve Ucircumflex Udieresis Udotbelow Ugrave Uhookabove Uhorn Uhornacute Uhorndotbelow Uhorngrave Uhornhookabove Uhorntilde Uhungarumlaut Umacron Uogonek Uring Utilde V W Wacute Wcircumflex Wdieresis Wgrave X Y Yacute Ycircumflex Ydieresis Ydotbelow Ygrave Yhookabove Ytilde Z Zacute Zcaron Zdotaccent eight five four nine one seven six three two uni021A zero];
@OPEN = [parenleft bracketleft braceleft];
@OPEN_CASE = [parenleft.case bracketleft.case braceleft.case];
@CLOSE = [parenright bracketright braceright];
